# DAWN V4 — copy values into a local .env file; never commit secrets
DAWN_TENANT_KEY=deus-intus
DAWN_DATA_PLANE_STATUS=PREPARED_NOT_CONNECTED
DAWN_WRITE_MODE=STAGING_ONLY
DAWN_CONNECTOR_STATE=DECLARED_UNPROVEN

# Canonical database
DATABASE_URL=postgresql://dawn_app:REPLACE_ME@localhost:5432/dawn_v4

# Derived semantic index
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=dawn_v4_deus_intus

# Local model service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Keep tokens and tunnel credentials only in the Mac Mini's private environment
# COMPOSIO_API_KEY=
# GITHUB_TOKEN=
# CLOUDFLARE_TUNNEL_TOKEN=
